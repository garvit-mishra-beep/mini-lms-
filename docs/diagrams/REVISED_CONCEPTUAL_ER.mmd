%% Revised Implementation-Ready Conceptual ER Diagram (Final Approved)
%% MiniLMS - ITM University CSL0311 DBMS PBL
%% Reflects all improvements from peer review audit (Weak entities, BCNF assessment questions, attendance subsystem, DAG prerequisites)

erDiagram
    USER ||--o| STUDENT : "specializes as (1:1 Disjoint)"
    USER ||--o| TEACHER : "specializes as (1:1 Disjoint)"
    USER ||--o{ AUDIT_LOG : "performs actions"

    TEACHER }|--|{ COURSE : "instructs (M:N via COURSE_INSTRUCTORS)"
    STUDENT }|--|{ COURSE : "enrolls (M:N via ENROLLMENTS)"

    COURSE ||--o{ MODULE : "contains (1:N Hierarchical)"
    MODULE ||--|{ LESSON : "contains (1:N Hierarchical)"
    LESSON }o--o{ LESSON : "prerequisite for (Recursive M:N Acyclic DAG)"
    LESSON ||--o| QUIZ : "assesses (1:1 Optional)"

    QUIZ ||--|{ QUIZ_QUESTION : "composed of (1:N Cascading)"
    QUIZ_QUESTION ||--|{ QUIZ_OPTION : "has choices (1:N Cascading)"

    ENROLLMENTS ||--o{ ATTEMPT : "submits (1:N)"
    QUIZ ||--o{ ATTEMPT : "attempted via (1:N)"
    ATTEMPT ||--|{ ATTEMPT_ANSWER : "records answer (1:N Cascading)"
    QUIZ_QUESTION ||--o{ ATTEMPT_ANSWER : "evaluates (1:N)"
    QUIZ_OPTION ||--o{ ATTEMPT_ANSWER : "selected choice (1:N)"

    COURSE ||--o{ ATTENDANCE_SESSION : "conducts (1:N Master)"
    ATTENDANCE_SESSION ||--|{ ATTENDANCE_RECORD : "identifies (1:N Identifying Weak Entity)"
    ENROLLMENTS ||--o{ ATTENDANCE_RECORD : "presence status (1:N)"

    ENROLLMENTS ||--|| COMPLETION : "tracks progress (1:1 Mandatory)"
    ENROLLMENTS ||--o| GRADE : "evaluates (1:1 Optional)"
    GRADE ||--o{ GRADE_CHANGE_HISTORY : "audits corrections (1:N)"
    ENROLLMENTS ||--o| CERTIFICATE : "awarded (1:1 Optional)"
    ENROLLMENTS ||--o{ LESSON_PROGRESS : "milestones completed (1:N)"
    LESSON ||--o{ LESSON_PROGRESS : "completed in (1:N)"

    USER {
        int user_id PK
        string full_name
        string email UK
        string password_hash
        enum role "ADMIN, TEACHER, STUDENT"
        enum status "ACTIVE, INACTIVE"
        timestamp created_at
    }

    STUDENT {
        int student_id PK
        int user_id FK,UK
        string roll_no UK
        string enrollment_no UK
        string phone
        date dob
    }

    TEACHER {
        int teacher_id PK
        int user_id FK,UK
        string employee_code UK
        string qualification
        text bio
        string phone_no
    }

    COURSE {
        int course_id PK
        string course_code UK
        string title
        text description
        enum status "DRAFT, PUBLISHED, ARCHIVED"
        timestamp created_at
    }

    COURSE_INSTRUCTORS {
        int course_id PK,FK
        int teacher_id PK,FK
        enum instructor_role "OWNER, INSTRUCTOR"
        boolean is_authorized
        timestamp assigned_at
    }

    MODULE {
        int module_id PK
        int course_id FK
        string title
        int sequence_no
    }

    LESSON {
        int lesson_id PK
        int module_id FK
        string title
        text content_text
        int sequence_no
        boolean is_restricted
        datetime release_date
        boolean required_for_completion
    }

    LESSON_PREREQUISITES {
        int lesson_id PK,FK
        int prerequisite_lesson_id PK,FK
    }

    ENROLLMENTS {
        int enrollment_id PK
        int student_id FK
        int course_id FK
        enum status "ACTIVE, COMPLETED, CANCELLED"
        int active_course_id UK "Generated Stored Virtual"
        timestamp enrolled_at
    }

    QUIZ {
        int quiz_id PK
        int lesson_id FK
        string title
        decimal max_score
        int allowed_attempts
        datetime available_from
        datetime available_until
        boolean required_for_completion
    }

    QUIZ_QUESTION {
        int question_id PK
        int quiz_id FK
        text question_text
        decimal points
        int sequence_no
    }

    QUIZ_OPTION {
        int option_id PK
        int question_id FK
        string option_text
        boolean is_correct "Server Side Anti-Cheat"
        int sequence_no
    }

    ATTEMPT {
        int attempt_id PK
        int quiz_id FK
        int enrollment_id FK
        int attempt_no
        decimal score
        enum status "IN_PROGRESS, SUBMITTED"
        datetime started_at
        datetime submitted_at
    }

    ATTEMPT_ANSWER {
        int answer_id PK
        int attempt_id FK
        int question_id FK
        int selected_option_id FK
        boolean is_correct
        decimal points_awarded
        timestamp answered_at
    }

    ATTENDANCE_SESSION {
        int session_id PK
        int course_id FK
        date session_date
        time start_time
        string topic
    }

    ATTENDANCE_RECORD {
        int session_id PK,FK "Weak Entity Identifying Key"
        int enrollment_id PK,FK "Weak Entity Identifying Key"
        enum status "PRESENT, ABSENT, EXCUSED, LATE"
        timestamp marked_at
    }

    COMPLETION {
        int enrollment_id PK,FK
        enum completion_status "IN_PROGRESS, COMPLETED"
        datetime completed_at
    }

    GRADE {
        int grade_id PK
        int enrollment_id FK,UK
        decimal final_score
        string letter_grade
        boolean published
        datetime published_at
    }

    GRADE_CHANGE_HISTORY {
        bigint change_id PK
        int grade_id FK
        int changed_by FK
        decimal old_score
        decimal new_score
        timestamp changed_at
        string reason
    }

    CERTIFICATE {
        int certificate_id PK
        int enrollment_id FK,UK
        string certificate_code UK
        timestamp issued_at
    }

    AUDIT_LOG {
        bigint audit_id PK
        string entity_name
        int entity_id
        string action_type
        int performed_by FK
        string details
        timestamp action_time
    }
