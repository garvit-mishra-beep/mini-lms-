flowchart TB
    subgraph LocalWorkstation ["Local Laboratory Topology (Single-Node Workstation)"]
        BrowserLocal["Evaluator Web Browser\n(Google Chrome / Edge)"]
        LocalHost["Host Workstation\n(Windows 10/11 or Ubuntu Linux)"]
        
        subgraph LocalAppEnv ["Python Virtual Environment (.venv)"]
            FlaskDev["Flask 3.0 Development Server\n(Port 5000 / 127.0.0.1)"]
            LocalPyMySQL["PyMySQL / mysql-connector-python"]
        end
        
        subgraph LocalDBServer ["Local RDBMS Engine"]
            LocalMySQL["MySQL Community Server 8.0.36\n(Port 3306 / minilms_db)"]
            LocalStorage["Local Disk Tablespace\n(/var/lib/mysql or C:/ProgramData/MySQL)"]
        end

        BrowserLocal -->|HTTP 1.1 / Session Cookies| FlaskDev
        FlaskDev --> LocalPyMySQL
        LocalPyMySQL -->|TCP Connection 127.0.0.1:3306| LocalMySQL
        LocalMySQL --> LocalStorage
    end

    subgraph CloudStaging ["Cloud Production-Ready Topology (PaaS / Twelve-Factor)"]
        ClientInternet["Remote Students & Faculty"]
        CloudProxy["Cloudflare CDN & Reverse Proxy\n(HTTPS / TLS 1.3 Termination, DDoS Shield)"]
        
        subgraph ContainerCompute ["Containerized Web Service (Railway.app)"]
            GunicornWSGI["Gunicorn WSGI Master (3 Workers)\n(Port $PORT)"]
            FlaskProd["Stateless Flask Application\n(Environment Secrets Injected)"]
        end
        
        subgraph CloudDataTier ["Managed Cloud Database & Storage"]
            ManagedMySQL["Managed MySQL 8.0 Database\n(Private Network / SSL Required)"]
            CloudBucket["Encrypted Object Storage\n(Coursework Submissions & Materials)"]
        end

        ClientInternet -->|HTTPS / Port 443| CloudProxy
        CloudProxy -->|Reverse Proxy Forward| GunicornWSGI
        GunicornWSGI --> FlaskProd
        FlaskProd -->|Encrypted TCP / SSL| ManagedMySQL
        FlaskProd -->|Signed REST API| CloudBucket
    end
