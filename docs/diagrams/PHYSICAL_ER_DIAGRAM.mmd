erDiagram
    departments ||--o{ users : "FK_users_dept"
    departments ||--o{ courses : "FK_courses_dept"
    
    users ||--|| students : "PK_FK_students_user"
    users ||--|| faculty : "PK_FK_faculty_user"
    users ||--o{ announcements : "FK_ann_author"
    users ||--o{ audit_logs : "FK_audit_user"
    
    courses ||--o{ course_offerings : "FK_offering_course"
    academic_terms ||--o{ course_offerings : "FK_offering_term"
    
    course_offerings ||--o{ faculty_allocations : "FK_alloc_offering"
    faculty ||--o{ faculty_allocations : "FK_alloc_faculty"
    
    students ||--o{ enrollments : "FK_enroll_student"
    course_offerings ||--o{ enrollments : "FK_enroll_offering"
    
    course_offerings ||--o{ attendance_sessions : "FK_att_sess_offering"
    faculty ||--o{ attendance_sessions : "FK_att_sess_faculty"
    
    attendance_sessions ||--|{ attendance_records : "FK_att_rec_session (CASCADE)"
    enrollments ||--o{ attendance_records : "FK_att_rec_enrollment (CASCADE)"
    
    course_offerings ||--o{ assignments : "FK_assign_offering"
    faculty ||--o{ assignments : "FK_assign_creator"
    
    assignments ||--o{ submissions : "FK_sub_assignment (CASCADE)"
    enrollments ||--o{ submissions : "FK_sub_enrollment (CASCADE)"
    
    submissions ||--o| grades : "FK_grade_submission (CASCADE)"
    faculty ||--o{ grades : "FK_grade_faculty"
    
    course_offerings ||--o{ course_materials : "FK_mat_offering"
    faculty ||--o{ course_materials : "FK_mat_faculty"
    
    course_offerings ||--o{ announcements : "FK_ann_offering"
    enrollments ||--o{ academic_risks : "FK_risk_enrollment"

    departments {
        INT_UNSIGNED department_id PK "AUTO_INCREMENT"
        VARCHAR_10 department_code UK "NOT NULL"
        VARCHAR_100 department_name UK "NOT NULL"
        VARCHAR_100 building "NULL"
        TINYINT_1 is_active "NOT NULL DEFAULT 1"
        DATETIME created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    users {
        INT_UNSIGNED user_id PK "AUTO_INCREMENT"
        VARCHAR_50 username UK "NOT NULL"
        VARCHAR_120 email UK "NOT NULL"
        VARCHAR_255 password_hash "NOT NULL"
        ENUM role "ADMIN,FACULTY,STUDENT,COORDINATOR"
        VARCHAR_50 first_name "NOT NULL"
        VARCHAR_50 last_name "NOT NULL"
        INT_UNSIGNED department_id FK "NULL"
        TINYINT_1 is_active "NOT NULL DEFAULT 1"
        DATETIME created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    students {
        INT_UNSIGNED student_id PK_FK "REFERENCES users(user_id) CASCADE"
        VARCHAR_30 enrollment_no UK "NOT NULL"
        DATE admission_date "NOT NULL"
        TINYINT_UNSIGNED current_semester "CHECK BETWEEN 1 AND 8"
        DECIMAL_4_2 cgpa "CHECK BETWEEN 0.00 AND 10.00"
        ENUM status "ACTIVE,SUSPENDED,ALUMNI,DROPOUT"
    }

    faculty {
        INT_UNSIGNED faculty_id PK_FK "REFERENCES users(user_id) CASCADE"
        VARCHAR_30 employee_code UK "NOT NULL"
        VARCHAR_50 designation "NOT NULL"
        VARCHAR_100 qualification "NULL"
        DATE joining_date "NOT NULL"
        VARCHAR_150 specialization "NULL"
    }

    academic_terms {
        INT_UNSIGNED term_id PK "AUTO_INCREMENT"
        VARCHAR_20 term_code UK "NOT NULL"
        VARCHAR_50 term_name "NOT NULL"
        DATE start_date "NOT NULL"
        DATE end_date "NOT NULL CHECK end_date >= start_date"
        TINYINT_1 is_current "NOT NULL DEFAULT 0"
    }

    courses {
        INT_UNSIGNED course_id PK "AUTO_INCREMENT"
        VARCHAR_20 course_code UK "NOT NULL"
        VARCHAR_150 course_name "NOT NULL"
        DECIMAL_3_1 credits "CHECK BETWEEN 1.0 AND 10.0"
        INT_UNSIGNED department_id FK "NOT NULL"
        TEXT description "NULL"
        TINYINT_1 is_active "NOT NULL DEFAULT 1"
    }

    course_offerings {
        INT_UNSIGNED offering_id PK "AUTO_INCREMENT"
        INT_UNSIGNED course_id FK "NOT NULL"
        INT_UNSIGNED term_id FK "NOT NULL"
        VARCHAR_10 section_name "NOT NULL DEFAULT 'A'"
        SMALLINT_UNSIGNED max_capacity "CHECK BETWEEN 5 AND 300"
        SMALLINT_UNSIGNED enrolled_count "CHECK enrolled_count <= max_capacity"
        ENUM status "PLANNED,OPEN,CLOSED,COMPLETED"
    }

    faculty_allocations {
        INT_UNSIGNED allocation_id PK "AUTO_INCREMENT"
        INT_UNSIGNED offering_id FK "NOT NULL"
        INT_UNSIGNED faculty_id FK "NOT NULL"
        ENUM role_in_course "PRIMARY,CO_INSTRUCTOR,TEACHING_ASSISTANT"
        DATETIME assigned_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    enrollments {
        INT_UNSIGNED enrollment_id PK "AUTO_INCREMENT"
        INT_UNSIGNED student_id FK "NOT NULL"
        INT_UNSIGNED offering_id FK "NOT NULL"
        DATE enrollment_date "NOT NULL"
        ENUM status "ENROLLED,DROPPED,COMPLETED,FAILED"
        VARCHAR_5 final_grade "NULL"
        DECIMAL_5_2 total_attendance_pct "CHECK BETWEEN 0.00 AND 100.00"
    }

    attendance_sessions {
        INT_UNSIGNED session_id PK "AUTO_INCREMENT"
        INT_UNSIGNED offering_id FK "NOT NULL"
        INT_UNSIGNED faculty_id FK "NOT NULL"
        DATE session_date "NOT NULL"
        VARCHAR_200 topic_covered "NULL"
        DATETIME created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    attendance_records {
        INT_UNSIGNED session_id PK_FK "COMPOSITE PK REFERENCES attendance_sessions CASCADE"
        INT_UNSIGNED enrollment_id PK_FK "COMPOSITE PK REFERENCES enrollments CASCADE"
        ENUM status "PRESENT,ABSENT,LATE,EXCUSED"
        VARCHAR_100 remarks "NULL"
        DATETIME marked_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    assignments {
        INT_UNSIGNED assignment_id PK "AUTO_INCREMENT"
        INT_UNSIGNED offering_id FK "NOT NULL"
        VARCHAR_150 title "NOT NULL"
        TEXT description "NULL"
        DECIMAL_5_2 max_marks "CHECK max_marks > 0.00"
        DECIMAL_4_2 weightage_pct "CHECK BETWEEN 0.00 AND 100.00"
        DATETIME due_date "NOT NULL"
        INT_UNSIGNED created_by FK "NOT NULL"
    }

    submissions {
        INT_UNSIGNED submission_id PK "AUTO_INCREMENT"
        INT_UNSIGNED assignment_id FK "NOT NULL"
        INT_UNSIGNED enrollment_id FK "NOT NULL"
        TEXT submission_text "NULL"
        VARCHAR_255 file_path "NULL"
        DATETIME submitted_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
        ENUM status "SUBMITTED,LATE,EVALUATED,RESUBMITTED"
    }

    grades {
        INT_UNSIGNED grade_id PK "AUTO_INCREMENT"
        INT_UNSIGNED submission_id UK_FK "REFERENCES submissions CASCADE"
        DECIMAL_5_2 marks_obtained "CHECK marks_obtained >= 0.00"
        TEXT feedback "NULL"
        INT_UNSIGNED graded_by FK "NOT NULL"
        DATETIME graded_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    course_materials {
        INT_UNSIGNED material_id PK "AUTO_INCREMENT"
        INT_UNSIGNED offering_id FK "NOT NULL"
        VARCHAR_150 title "NOT NULL"
        VARCHAR_255 file_path "NOT NULL"
        VARCHAR_50 file_type "NULL"
        BIGINT_UNSIGNED file_size_bytes "NULL"
        INT_UNSIGNED uploaded_by FK "NOT NULL"
    }

    announcements {
        INT_UNSIGNED announcement_id PK "AUTO_INCREMENT"
        VARCHAR_150 title "NOT NULL"
        TEXT content "NOT NULL"
        INT_UNSIGNED offering_id FK "NULL"
        INT_UNSIGNED author_id FK "NOT NULL"
        DATETIME created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    academic_risks {
        INT_UNSIGNED risk_id PK "AUTO_INCREMENT"
        INT_UNSIGNED enrollment_id FK "NOT NULL"
        ENUM risk_type "ATTENDANCE,ACADEMIC_PERFORMANCE,COMBINED"
        ENUM risk_level "LOW,MEDIUM,HIGH,CRITICAL"
        DECIMAL_5_2 risk_score "CHECK BETWEEN 0.00 AND 100.00"
        TEXT rationale "NOT NULL"
        ENUM status "ACTIVE,ACKNOWLEDGED,RESOLVED,DISMISSED"
    }

    audit_logs {
        BIGINT_UNSIGNED log_id PK "AUTO_INCREMENT"
        INT_UNSIGNED user_id FK "NULL"
        VARCHAR_50 action "NOT NULL"
        VARCHAR_50 table_name "NULL"
        INT_UNSIGNED record_id "NULL"
        JSON old_values "NULL"
        JSON new_values "NULL"
        VARCHAR_45 ip_address "NULL"
        DATETIME created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }
