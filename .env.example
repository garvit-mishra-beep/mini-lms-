# MiniLMS Database Configuration (Local MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=minilms_db

# Isolated Database for Automated Unit & Integration Tests
TEST_DB_NAME=minilms_test_db

# Flask Application Security
# Set FLASK_SECRET_KEY to a cryptographically secure random string in production
FLASK_SECRET_KEY=replace_with_a_random_private_string
PORT=5000

# Viva Demonstration Mode
# Set to 'true' ONLY for local classroom evaluation / demo role switcher.
# Set to 'false' for production or public security demonstrations.
DEMO_MODE=false
DEMO_USER_PASSWORD=replace_with_secure_demo_password
