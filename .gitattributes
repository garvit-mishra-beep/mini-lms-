# Git Attributes
* text=auto eol=lf

*.py text diff=python eol=lf
*.sql text diff=sql eol=lf
*.html text diff=html eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.zip binary
