[Unit]
Description=MiniLMS Flask Application WSGI Daemon
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/minilms
Environment="PATH=/opt/minilms/venv/bin"
EnvironmentFile=/opt/minilms/.env
ExecStart=/opt/minilms/venv/bin/gunicorn --workers 4 --bind 127.0.0.1:5000 --access-logfile /var/log/minilms/access.log --error-logfile /var/log/minilms/error.log wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
